# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# NextAuth
# Local dev: http://localhost:3000
# Production (sort-ed.org, bought on GoDaddy, DNS pointed at Vercel): https://sort-ed.org
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=           # generate with: openssl rand -base64 32

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Enable: Gmail API, Google Calendar API
# Scopes requested by the app: gmail.readonly, calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (api.slack.com/apps → your app → OAuth & Permissions)
# User Token Scopes needed: channels:history, channels:read, groups:history, im:history, mpim:history
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Ko-fi — just your Ko-fi username, no API key needed for a donate link
NEXT_PUBLIC_KOFI_USERNAME=yourusername
